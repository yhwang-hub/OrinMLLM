    name = "llminfer_kernel",
    srcs = [
        "LLMInfer/kernel/cuda_kernel_jit_builder.cpp",
        "LLMInfer/kernel/kernel_factory.cpp",
    ],
    hdrs = glob(["LLMInfer/kernel/*.h"]),
    copts = ["-std=c++17"],
    includes = ["LLMInfer"],
)

cc_library(
    name = "llminfer_test_utils",
    hdrs = ["test/llminfer/test_utils.h"],
    includes = ["."],
)

