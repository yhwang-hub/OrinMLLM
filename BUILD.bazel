package(default_visibility = ["//visibility:public"])

cc_library(
    name = "llminfer_graph",
    srcs = glob([
        "LLMInfer/graph/**/*.cpp",
    ]),
    hdrs = glob([
        "LLMInfer/graph/**/*.h",
    ]),
    copts = ["-std=c++17"],
    includes = ["LLMInfer"],
)

cc_library(
    name = "llminfer_stream",
    srcs = ["LLMInfer/stream/stream.cpp"],
    hdrs = ["LLMInfer/stream/stream.h"],
    copts = ["-std=c++17"],
    includes = ["LLMInfer"],
)

